  "components" : {
    "schemas" : {
      "UpdateProfileRequest" : {
        "type" : "object",
        "properties" : {
          "display_name" : {
            "type" : "string",
            "maxLength" : 20,
            "minLength" : 0
          },
          "gender" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "male|female|other|private"
          },
          "birthday" : {
            "type" : "string",
            "pattern" : "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required" : [ "display_name", "gender" ]
      },
      "AccountProfileResponse" : {
        "type" : "object",
        "properties" : {
          "account_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "display_name" : {
            "type" : "string"
          },
          "gender" : {
            "type" : "string"
          },
          "birthday" : {
            "type" : "string",
            "format" : "date"
          },
          "updated_at" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "SessionRequest" : {
        "type" : "object",
        "properties" : {
          "account_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "account_key" : {
            "type" : "string"
          }
        }
      },
      "SessionResponse" : {
        "type" : "object",
        "properties" : {
          "account_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "display_name" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          },
          "login_token" : {
            "type" : "string"
          },
          "login_expires_at" : {
            "type" : "string",
            "format" : "date-time"
          },
          "turms" : {
            "$ref" : "#/components/schemas/Turms"
          },
          "expires_at" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "Turms" : {
        "type" : "object",
        "properties" : {
          "user_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "credential" : {
            "type" : "string"
          },
          "gateway_url" : {
            "type" : "string"
          }
        }
      },
      "RoomCreateRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 20,
            "minLength" : 0
          }
        },
        "required" : [ "name" ]
      },
      "CreateResponse" : {
        "type" : "object",
        "properties" : {
          "room_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "name" : {
            "type" : "string"
          },
          "owner_account_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "created_at" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "AddMemberRequest" : {
        "type" : "object",
        "properties" : {
          "account_id" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "account_id" ]
      },
      "MemberResponse" : {
        "type" : "object",
        "properties" : {
          "room_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "account_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "joined_at" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "FriendshipCreateRequest" : {
        "type" : "object",
        "properties" : {
          "peer_account_id" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "peer_account_id" ]
      },
      "RequestResponse" : {
        "type" : "object",
        "properties" : {
          "peer_account_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "status" : {
            "type" : "string"
          },
          "incoming" : {
            "type" : "boolean"
          }
        }
      },
      "RespondRequest" : {
        "type" : "object",
        "properties" : {
          "action" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "accept|reject"
          }
        },
        "required" : [ "action" ]
      },
      "AcceptResponse" : {
        "type" : "object",
        "properties" : {
          "peer_account_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "status" : {
            "type" : "string"
          }
        }
      },
      "SendRequest" : {
        "type" : "object",
        "properties" : {
          "text" : {
            "type" : "string",
            "maxLength" : 500,
            "minLength" : 0
          }
        },
        "required" : [ "text" ]
      },
      "Conversation" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          }
        }
      },
      "SendResponse" : {
        "type" : "object",
        "properties" : {
          "message_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "conversation" : {
            "$ref" : "#/components/schemas/Conversation"
          },
          "sent_at" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "BlocklistCreateRequest" : {
        "type" : "object",
        "properties" : {
          "account_id" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "account_id" ]
      },
      "BlocklistItem" : {
        "type" : "object",
        "properties" : {
          "account_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "display_name" : {
            "type" : "string"
          },
          "created_at" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "RegisterRequest" : {
        "type" : "object",
        "properties" : {
          "email" : {
            "type" : "string",
            "maxLength" : 254,
            "minLength" : 0,
            "pattern" : "^[^@]+@.+$"
          },
          "password" : {
            "type" : "string",
            "maxLength" : 72,
            "minLength" : 8,
            "pattern" : ".*[^0-9].*"
          },
          "display_name" : {
            "type" : "string",
            "maxLength" : 20,
            "minLength" : 0
          }
        },
        "required" : [ "display_name", "email", "password" ]
      },
      "RegisterResponse" : {
        "type" : "object",
        "properties" : {
          "account_id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "display_name" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string"
          }
        }
      },
      "AccountSummary" : {
        "type" : "object",
