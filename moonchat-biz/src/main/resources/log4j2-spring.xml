<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志实现是 Log4j2（pom 里换掉了 Logback），这是 Boot 装配版的配置文件名。
  只输出到控制台：容器里日志走 stdout，落盘、轮转、采集都是部署侧的事，V1 不在仓库里定。
  application.yml 里的 logging.level.* 仍然生效，所以这里只固定格式与根级别。
  S4 的来源与限流命中要写成结构化日志，到那时再决定要不要换 JSON 布局（现在不加那个依赖）。
-->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Logger name="im.moonchat" level="INFO"/>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
