{
  "name": "jadekaninchen",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Jadekaninchen：把 MondChat 的私聊/群接成 DSH 会话的 OneBot 12 应用端",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "src",
    "selftest.mjs",
    "mock-onebot.mjs",
    "mock-onebot.test.mjs"
  ],
  "scripts": {
    "test": "node selftest.mjs && node mock-onebot.test.mjs",
    "mock": "node mock-onebot.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
